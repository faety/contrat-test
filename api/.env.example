# Boyia API — variables d'environnement (jamais de secret dans Git)
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production
# Base de données : sqlite (démo) ou postgres (production)
DB_DRIVER=sqlite
DB_PATH=./data/boyia.sqlite
# DATABASE_URL=postgres://user:pass@host:5432/boyia
CORS_ORIGIN=http://localhost:3000
